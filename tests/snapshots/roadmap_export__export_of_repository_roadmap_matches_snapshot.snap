    {
      "number": "6",
      "title": "Add agent-native validation and output contracts",
      "entries": [
        {
          "key": "Idea",
          "value": "`mapsplice` should be usable safely by agents and humans before it edits roadmaps. A dedicated validator, miette-style human diagnostics, and strict JSON contracts make syntax errors, dependency drift, and broken links visible without requiring an edit attempt.",
          "entries": []
        }
      ],
      "requires": [],
      "steps": [
        {
          "number": "6.1",
          "title": "Validate roadmap structure, links, and dependencies",
          "question": "This step answers whether maintainers can run one command that proves a roadmap is syntactically valid, internally linked, and dependency-consistent. Its outcome informs whether agents can treat validation output as bounded machine evidence rather than prose-only terminal text.",
          "entries": [],
          "requires": [],
          "tasks": [
            {
              "number": "6.1.1",
              "title": "Add a `validate` subcommand and validation result model.",
              "state": "open",
              "requires": [
                "5.1.4"
              ],
              "entries": [
                {
                  "key": null,
                  "value": "Extend the parser error channel for multi-finding validation with source ranges, then reuse the roadmap model to classify syntax, dependency, and link findings without mutating the target document.",
                  "entries": []
                },
                {
                  "key": null,
                  "value": "See docs/validation-and-agent-output-design.md.",
                  "entries": []
                },
                {
                  "key": "Success",
                  "value": "`mapsplice validate docs/roadmap.md` exits successfully for a valid roadmap, reports typed findings for invalid roadmaps, and never emits rewritten roadmap Markdown.",
                  "entries": []
                }
              ],
              "details": []
            },
            {
              "number": "6.1.2",
              "title": "Check dependency references and Markdown links.",
              "state": "open",
              "requires": [
                "6.1.1"
              ],
              "entries": [
                {
                  "key": null,
                  "value": "Validate every `Requires` anchor against the parsed roadmap and validate local Markdown links against headings, files, and fragments, with file and fragment resolution confined to the workspace repository root. Link checks must not follow `../` paths that escape that root or external targets.",
                  "entries": []
                },
                {
                  "key": "Success",
                  "value": "missing anchors, malformed dependency tokens, missing files, and unresolved local heading fragments are reported with stable finding codes.",
                  "entries": []
                }
              ],
              "details": []
            },
            {
              "number": "6.1.3",
              "title": "Detect dependency cycles and self-references.",
              "state": "open",
              "requires": [
                "6.1.2"
              ],
              "entries": [
                {
                  "key": null,
                  "value": "Walk the parsed dependency graph and report any cycle, including a task that requires itself, with the full cycle path in the finding.",
                  "entries": []
                },
                {
                  "key": "Success",
                  "value": "a roadmap containing `A requires B, B requires A` and a roadmap containing a self-reference each produce an error-severity finding with a stable code, and an acyclic roadmap produces none.",
                  "entries": []
                }
              ],
              "details": []
            },
            {
              "number": "6.1.4",
              "title": "Report advisory dependency-hygiene findings.",
              "state": "open",
              "requires": [
                "6.1.3"
              ],
              "entries": [
                {
                  "key": null,
                  "value": "Add note-severity findings for transitively redundant references \\(an item requires both a prerequisite and something that prerequisite already requires\\) and for status inconsistencies \\(a checked item that requires an unchecked item\\).",
                  "entries": []
                },
                {
                  "key": "Success",
                  "value": "fixtures pin both advisory findings with stable codes, neither affects the exit class on its own, and a clean roadmap reports neither.",
                  "entries": []
                }
              ],
              "details": []
            },
            {
              "number": "6.1.5",
              "title": "Render miette-style human diagnostics.",
              "state": "open",
              "requires": [
                "6.1.1"
              ],
              "entries": [
                {
                  "key": null,
                  "value": "Use source spans, labels, help text, and stable diagnostic codes so human output identifies the relevant roadmap line and the repair action.",
                  "entries": []
                },
                {
                  "key": "Success",
                  "value": "fixtures pin graphical diagnostics for syntax, dependency, and link findings, with colour and URL variance disabled for deterministic tests.",
                  "entries": []
                }
              ],
              "details": []
            }
          ],
          "trailing": []
        },
        {
          "number": "6.2",
          "title": "Align every command with agent-native output contracts",
          "question": "This step answers whether `mapsplice` has one coherent output contract across edit, validate, and future maintenance commands. Its outcome informs whether agents can call the tool without scraping human prose or guarding against mixed stdout payloads.",
          "entries": [],
          "requires": [],
          "tasks": [
            {
              "number": "6.2.1",
              "title": "Add global `--json` output mode.",
              "state": "open",
              "requires": [
                "6.1.1"
              ],
              "entries": [
                {
                  "key": null,
                  "value": "Return exactly one JSON document on success and one JSON diagnostic document on failure, keeping human diagnostics on stderr in non-JSON mode.",
                  "entries": []
                },
                {
                  "key": null,
                  "value": "See [https://github.com/leynos/ortho-config/blob/main/docs/agent-native-cli-design.md](https://github.com/leynos/ortho-config/blob/main/docs/agent-native-cli-design.md) and docs/validation-and-agent-output-design.md.",
                  "entries": []
                },
                {
                  "key": "Success",
                  "value": "every subcommand has a pinned JSON success schema, failure schema, stdout contract, stderr contract, exit-code class, clap-usage fallback, and tracing policy.",
                  "entries": []
                }
              ],
              "details": []
            },
            {
              "number": "6.2.2",
              "title": "Emit structured edit summaries for mutating commands.",
              "state": "open",
              "requires": [
                "6.2.1"
              ],
              "entries": [
                {
                  "key": null,
                  "value": "Summarize operation kind, target path, in-place status, rewritten target, inserted or removed anchors, renumber mappings, dependency rewrites, and emitted artefact hash.",
                  "entries": []
                },
                {
                  "key": "Success",
                  "value": "append, insert, delete, and replace can be run with `--json` using `--in-place` without losing the rewritten roadmap body or leaking non-JSON bytes.",
                  "entries": []
                }
              ],
              "details": []
            },
            {
              "number": "6.2.3",
              "title": "Export the parsed roadmap graph as JSON.",
              "state": "open",
              "requires": [
                "6.2.1"
              ],
              "entries": [
                {
                  "key": null,
                  "value": "Emit the parsed model — phases, steps, tasks, sub-tasks, checkbox status, and resolved dependency edges — as a schema-versioned JSON document, so agents and downstream tooling can query ready tasks, critical paths, and status consistency without reparsing Markdown.",
                  "entries": []
                },
                {
                  "key": "Success",
                  "value": "a documented command produces one JSON document whose anchors, statuses, and dependency edges match the parsed roadmap exactly, pinned by a golden fixture.",
                  "entries": []
                }
              ],
              "details": []
            },
            {
              "number": "6.2.4",
              "title": "Publish compact agent context for the CLI.",
              "state": "open",
              "requires": [
                "6.2.1"
              ],
              "entries": [
                {
                  "key": null,
                  "value": "Add a command or documented output that lists supported commands, mutation boundaries, output modes, exit classes, and examples in a compact machine-readable shape.",
                  "entries": []
                },
                {
                  "key": "Success",
                  "value": "the generated context names `validate`, all edit commands, and the `--json` contract in a schema-versioned payload.",
                  "entries": []
                }
              ],
              "details": []
            },
            {
              "number": "6.2.5",
              "title": "Package an agent skill for roadmap maintenance.",
              "state": "open",
              "requires": [
                "6.1.5",
                "6.2.4"
              ],
              "entries": [
                {
                  "key": null,
                  "value": "Author a skill that tells agents when to run validation, how to prefer JSON output, how to interpret miette diagnostics, and when to refuse unsafe roadmap edits.",
                  "entries": []
                },
                {
                  "key": "Success",
                  "value": "the skill is tested against the generated agent context, requires validate-before-edit and validate-after-edit, directs agents to inspect JSON diagnostics by `code` and `exit_class`, and stops for maintainer judgement on ambiguous links, duplicate anchors, or failed postflight checks.",
                  "entries": []
                }
              ],
              "details": []
            }
          ],
          "trailing": []
        }
      ],
      "trailing": []
    },
    {
      "number": "7",
      "title": "Renumber ExecPlans after roadmap updates",
      "entries": [
        {
          "key": "Idea",
          "value": "roadmap task numbers are embedded in ExecPlan filenames, headings, links, and historical references. When `mapsplice` renumbers a roadmap, it should be able to plan and apply the corresponding ExecPlan renumbering without erasing history or creating ambiguous references.",
          "entries": []
        }
      ],
      "requires": [],
      "steps": [
        {
          "number": "7.1",
          "title": "Discover and plan ExecPlan renumbering",
          "question": "This step answers whether `mapsplice` can identify which ExecPlans are tied to renumbered roadmap tasks before it changes any files. Its outcome informs the boundary between safe automated maintenance and cases that require maintainer review.",
          "entries": [],
          "requires": [],
          "tasks": [
            {
              "number": "7.1.1",
              "title": "Model roadmap-to-ExecPlan identity.",
              "state": "open",
              "requires": [
                "6.2.2"
              ],
              "entries": [
                {
                  "key": null,
                  "value": "Define how task anchors map to `docs/execplans/roadmap-*.md` filenames, titles, references, and in-document roadmap citations.",
                  "entries": []
                },
                {
                  "key": null,
                  "value": "See docs/execplan-renumbering-design.md.",
                  "entries": []
                },
                {
                  "key": "Success",
                  "value": "fixtures classify matching, missing, duplicate, conflicting, stale, and manually named ExecPlans without applying changes.",
                  "entries": []
                }
              ],
              "details": []
            },
            {
              "number": "7.1.2",
              "title": "Produce a dry-run renumber plan.",
              "state": "open",
              "requires": [
                "7.1.1"
              ],
              "entries": [
                {
                  "key": null,
                  "value": "Convert a roadmap edit's renumber map into an ExecPlan rename and rewrite plan, including conflicts, unchanged files, and review-required cases.",
                  "entries": []
                },
                {
                  "key": "Success",
                  "value": "`mapsplice` can emit a JSON dry-run plan that lists every proposed rename, content rewrite, skipped file, conflict, diagnostic, content hash, and destination anchor.",
                  "entries": []
                }
              ],
              "details": []
            },
            {
              "number": "7.1.3",
              "title": "Define history-preservation rules.",
              "state": "open",
              "requires": [
                "7.1.1"
              ],
              "entries": [
                {
                  "key": null,
                  "value": "Decide which historical references remain as old numbers, which links are rewritten, and how tombstones or redirects are represented when necessary.",
                  "entries": []
                },
                {
                  "key": "Success",
                  "value": "the design and fixtures distinguish live roadmap references from historical notes, audit evidence, and intentionally stale citations.",
                  "entries": []
                }
              ],
              "details": []
            }
          ],
          "trailing": []
        },
        {
          "number": "7.2",
          "title": "Decide whether to automate ExecPlan renumbering apply",
          "question": "This step answers whether dry-run evidence justifies building an apply engine instead of keeping ExecPlan renumbering as guided manual work. Its outcome informs whether the project accepts the extra recovery and history-preservation surface of automated writes.",
          "entries": [],
          "requires": [],
          "tasks": [
            {
              "number": "7.2.1",
              "title": "Measure dry-run demand before committing to apply automation.",
              "state": "open",
              "requires": [
                "7.1.2",
                "7.1.3"
              ],
              "entries": [
                {
                  "key": null,
                  "value": "Record dry-run reports from real roadmap updates and classify whether guided manual renames are rare, cheap, or repeatedly error-prone.",
                  "entries": []
                },
                {
                  "key": "Success",
                  "value": "proceed only if at least three dry-run reports show recurring manual pain; defer if reports are mixed or too sparse; reject if the reports show the manual flow is usually cheap and correct.",
                  "entries": []
                }
              ],
              "details": []
            },
            {
              "number": "7.2.2",
              "title": "Specify apply preconditions before any mutation.",
              "state": "open",
              "requires": [
                "7.2.1"
              ],
              "entries": [
                {
                  "key": null,
                  "value": "Refuse dirty git worktrees unless `--allow-dirty` is supplied, require matching dry-run content hashes, destination anchors present in the on-disk roadmap, no plan error diagnostics, no path conflicts, and no unresolved `review_needed` diagnostics unless the override is recorded in the JSON report. Target-state and conflict checks happen before any mutation.",
                  "entries": []
                },
                {
                  "key": "Success",
                  "value": "the design can prove an apply attempt cannot target a phantom roadmap state, cannot mutate after a failed preflight check, and can be recovered through git if interrupted.",
                  "entries": []
                }
              ],
              "details": []
            },
            {
              "number": "7.2.3",
              "title": "Implement guarded apply only if demand evidence justifies it.",
              "state": "open",
              "requires": [
                "7.2.2"
              ],
              "entries": [
                {
                  "key": null,
                  "value": "Apply stages, in order: preflight, prepare, rename, rewrite, postflight.",
                  "entries": []
                },
                {
                  "key": null,
                  "value": "Define rollback and cleanup for failures in `prepare`, `rename`, and `rewrite`, and fail closed before any partial writes if source-hash, destination-anchor, or conflict checks fail.",
                  "entries": []
                },
                {
                  "key": null,
                  "value": "Gate automation on an exhaustive proof, bounded model check, or documented finite-state argument for the full pipeline.",
                  "entries": []
                },
                {
                  "key": null,
                  "value": "Rename ExecPlan files and rewrite only allowlisted live links, titles, metadata fields, and current-roadmap references using capability-oriented filesystem operations.",
                  "entries": []
                },
                {
                  "key": "Success",
                  "value": "if built, apply preserves historical sections by default, and a second run returns a clear stale-plan diagnostic.",
                  "entries": []
                }
              ],
              "details": []
            },
            {
              "number": "7.2.4",
              "title": "Document operator recovery and agent boundaries.",
              "state": "open",
              "requires": [
                "7.2.3"
              ],
              "entries": [
                {
                  "key": null,
                  "value": "Explain dry-run review, guided manual renames, clean-worktree recovery, conflict handling, and when an agent must stop for maintainer judgement.",
                  "entries": []
                },
                {
                  "key": "Success",
                  "value": "the users' guide and agent skill cover normal dry-run renumbering, review-required conflicts, optional apply, and recovery from interrupted applies.",
                  "entries": []
                }
              ],
              "details": []
            }
          ],
          "trailing": []
        }
      ],
      "trailing": []
    },
    {
      "number": "8",
      "title": "Improve edit-surface ergonomics",
      "entries": [
        {
          "key": "Idea",
          "value": "dependency maintenance and structural edits should be small, reviewable operations. Editing a clause should not require rewriting a task body, a preview should not require shell plumbing, and appending should work at every structural level.",
          "entries": []
        }
      ],
      "requires": [],
      "steps": [
        {
          "number": "8.1",
          "title": "Edit dependency clauses as first-class operations",
          "question": "This step answers whether a maintainer or agent can change what a task requires without touching its prose. Its outcome informs whether large dependency audits can land as sequences of minimal, clause-only diffs.",
          "entries": [],
          "requires": [],
          "tasks": [
            {
              "number": "8.1.1",
              "title": "Add `deps set`, `deps add`, and `deps remove` subcommands.",
              "state": "open",
              "requires": [
                "6.2.2"
              ],
              "entries": [
                {
                  "key": null,
                  "value": "Rewrite only the target item's dependency clause, validating that every supplied anchor resolves in the parsed roadmap, and leave the rest of the item body byte-identical.",
                  "entries": []
                },
                {
                  "key": "Success",
                  "value": "each command edits a single clause, rejects unresolved anchors with a typed error, reports a structured edit summary, and produces no diff outside the clause.",
                  "entries": []
                }
              ],
              "details": []
            },
            {
              "number": "8.1.2",
              "title": "Emit dependency clauses in one canonical form.",
              "state": "open",
              "requires": [
                "8.1.1"
              ],
              "entries": [
                {
                  "key": null,
                  "value": "Define the canonical clause shape — a single source line, anchors in ascending order, house list punctuation — and emit it from `deps` commands and from renumbering rewrites of clauses already in canonical form.",
                  "entries": []
                },
                {
                  "key": "Success",
                  "value": "fixtures pin the canonical form for one, two, and many anchors, and a renumbering edit does not reflow a canonical clause across lines.",
                  "entries": []
                }
              ],
              "details": []
            }
          ],
          "trailing": []
        },
        {
          "number": "8.2",
          "title": "Preview and splice flexibility",
          "question": "This step answers whether previewing and appending are first-class rather than workflow conventions. Its outcome informs how much shell plumbing the agent skill can drop from the safe-edit loop.",
          "entries": [],
          "requires": [],
          "tasks": [
            {
              "number": "8.2.1",
              "title": "Add a `--diff` preview mode to mutating commands.",
              "state": "open",
              "requires": [
                "3.1.2"
              ],
              "entries": [
                {
                  "key": null,
                  "value": "Print a unified diff between the target and the would-be result on stdout without writing, as a first-class alternative to redirecting full output and diffing by hand.",
                  "entries": []
                },
                {
                  "key": "Success",
                  "value": "append, insert, delete, and replace accept `--diff`, write nothing to disk, and a fixture pins the diff format.",
                  "entries": []
                }
              ],
              "details": []
            },
            {
              "number": "8.2.2",
              "title": "Extend `append` to step and task level.",
              "state": "open",
              "requires": [
                "5.1.2"
              ],
              "entries": [
                {
                  "key": null,
                  "value": "Accept an optional parent anchor so a step fragment can be appended to a named phase and a task fragment to a named step, with the same renumbering and reference-rewrite guarantees as `insert`.",
                  "entries": []
                },
                {
                  "key": "Success",
                  "value": "appending a step to a phase and a task to a step both renumber nothing, place the new item last, and fail closed when the fragment level does not match the parent anchor.",
                  "entries": []
                }
              ],
              "details": []
            },
            {
              "number": "8.2.3",
              "title": "Preserve untouched-item indentation across splices.",
              "state": "done",
              "requires": [
                "3.1.4"
              ],
              "entries": [
                {
                  "key": null,
                  "value": "Preserve each unchanged task's source across insert, delete, and replace, so a structural edit produces no formatting churn outside the spliced region. Changed, renumbered, and dependency-rewritten tasks use canonical rendering.",
                  "entries": []
                },
                {
                  "key": "Success",
                  "value": "inserting one task into a large roadmap leaves every other item byte-identical, pinned by golden fixtures for insert, delete, and replace.",
                  "entries": []
                }
              ],
              "details": []
            }
          ],
          "trailing": []
        }
      ],
      "trailing": []
    }
  ]
}
